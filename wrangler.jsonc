{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prototype-leker-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prototype-leker-db",
      "database_id": "6977b54c-afce-4275-a0ad-d28e7d942e19",
      "migrations_dir": "migrations"
    }
  ]
}
