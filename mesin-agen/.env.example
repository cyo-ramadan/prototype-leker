# Salin file ini menjadi `mesin-agen/.env` lalu isi. File `.env` TIDAK ikut ke GitHub.
# Jangan kirim isinya ke chat mana pun (termasuk ke Hana).

# Kunci OpenRouter -- satu kunci untuk semua model di router.yaml. Buat di https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Papan tugas agen (agent-bus). Kosongkan token kalau mesin hanya dipakai langsung dari terminal.
MAXI_AGENT_BUS_URL=https://maxi-agent-bus-bridge.daily-napkin.workers.dev/mcp
MAXI_AGENT_BUS_TOKEN=

# Opsional
MESIN_NAMA=Mesin
MESIN_ROUTER_PORT=4000
