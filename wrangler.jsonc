{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prototype-leker-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-07",
  // Worker dijalankan dekat Singapura, bukan di data center terdekat pengguna.
  // 2026-09-30: Gemini menolak Caca dengan "User location is not supported"
  // karena request dari Indonesia kadang dilayani data center di wilayah yang
  // tidak didukung Google. Singapura didukung, dan D1 (APAC) juga dekat sana,
  // jadi query database tidak bertambah jauh. Lihat HANDOFF-CACA.md.
  "placement": {
    "region": "gcp:asia-southeast1"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"],
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prototype-leker-db",
      "database_id": "6977b54c-afce-4275-a0ad-d28e7d942e19",
      "migrations_dir": "migrations"
    }
  ],
  // Foto bukti transfer setoran CS (ADR-053, src/setoran-bukti.js). Bucket dibuat Bos Cyo
  // 2026-10-08. Binding WAJIB ada di sini: Workers Git Integration menjalankan `wrangler deploy`
  // dari file ini, jadi binding yang hanya ditambah lewat dashboard hilang di deploy berikutnya.
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "bukti-setoran"
    }
  ]
}
